---
import Social from "./Social.astro";
import site from "../data/site.json";
---

<footer>
  <div class="socials">
    <Social
      username={site.contacts[0]["primary-email"]}
      isEmail
      iconName={"envelope"}
    />
    <Social platform="github" username="withastro" useIcon iconName="github" />
  </div>
  <span><i class="fa fa-copyright"></i> 2025 - present {site.copy}</span>
</footer>

<style>
  footer {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 100px;
    padding: 1rem;
    background-color: var(--color-background);
    color: var(--color-foreground);
    gap: 1rem;
  }
  span {
    padding: 0rem 1rem;
    font-size: var(--fs-small);
    font-weight: var(--fw-light);
  }
</style>
