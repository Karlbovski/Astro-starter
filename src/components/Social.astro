---
import { Icon } from "astro-icon/components";
interface Props {
  platform?: string;
  username?: string;
  useIcon?: boolean;
  isEmail?: boolean;
  iconName?: string;
}
const {
  platform,
  username,
  useIcon = false,
  isEmail = false,
  iconName,
} = Astro.props;
---

{
  isEmail ? (
    <a href={`mailto:${username}`} class="social-icon">
      {" "}
      <Icon name={iconName} size="32" />
    </a>
  ) : useIcon ? (
    <a href={`https://${platform}.com/${username}`} class="social-icon">
      {" "}
      <Icon name={iconName} size="32" />
    </a>
  ) : (
    <a href={`https://www.${platform}.com/${username}`}>{platform}</a>
  )
}
<!-- <a href={`https://www.${platform}.com/${username}`}>{platform}</a>
<a href="" class="social-icon"> <i class="fa fa-instagram"></i></a> -->

<style>
  a {
    padding: 0.5rem 0.5rem;
    color: var(--color-foreground);
    background-color: var(--color-background);
    text-decoration: none;
    font-size: var(--fs-small);
  }
  .social-icon {
    font-size: 1.925rem;
    background-color: transparent;
  }
  .social-icon:hover {
    color: white;
  }
  [data-icon="envelope"] {
    color: #0072c6;
  }
  [data-icon="envelope"]:hover {
    color: #005999;
  }
  [data-icon="spotify"] {
    color: #1ed760;
  }
  [data-icon="spotify"]:hover {
    color: #1aa34a;
  }
  [data-icon="instagram"] {
    color: #e1306c;
  }
  [data-icon="instagram"]:hover {
    color: #b72a57;
  }
  [data-icon="apple"] {
    color: #000000;
  }
  [data-icon="apple"]:hover {
    color: #333333;
  }
  [data-icon="amazon"] {
    color: #ff9900;
  }
  [data-icon="amazon"]:hover {
    color: #cc7a00;
  }
